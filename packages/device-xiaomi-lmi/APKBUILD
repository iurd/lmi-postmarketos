build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# device-specific alsa ucm conf
	install -Dm644 "$srcdir/lmi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/lmi/lmi.conf"

	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/lmi/HiFi.conf"

	# ALSA looks the card up either by index (conf.d/<driver>/) or by
	# name (conf.virt.d/). The ASoC driver is "sm8250" for the UCM
	# lookup and the card is named "lmi" in the DTS.
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/snd-sm8250" \
		"$pkgdir/usr/share/alsa/ucm2/conf.virt.d"
	for _d in sm8250 snd-sm8250; do
		for _f in lmi Xiaomi-lmi sm8250 snd-sm8250; do
			ln -s ../../Xiaomi/lmi/lmi.conf \
				"$pkgdir/usr/share/alsa/ucm2/conf.d/$_d/$_f.conf"
		done
	done
	for _f in lmi Xiaomi-lmi; do
		ln -s ../Xiaomi/lmi/lmi.conf \
			"$pkgdir/usr/share/alsa/ucm2/conf.virt.d/$_f.conf"
	done

	# lmi runtime defaults: 300% scale, zh_CN, gmobile panel data
	install -Dm644 "$srcdir/phoc.ini" "$pkgdir/etc/phosh/phoc.ini"
	install -Dm644 "$srcdir/locale.conf" "$pkgdir/etc/locale.conf"
	install -Dm644 "$srcdir/phoshdebug" "$pkgdir/etc/skel/.phoshdebug"
	install -Dm644 "$srcdir/xiaomi,lmi.json" \
		"$pkgdir/usr/share/gmobile-lmi/xiaomi,lmi.json"

	# DHCP client replies + mDNS on top of pmOS base firewall
	install -Dm644 "$srcdir/60_lmi.nft" "$pkgdir/etc/nftables.d/60_lmi.nft"

	# fcitx5 native Wayland Chinese input
	install -Dm755 "$srcdir/fcitx5-session-start" \
		"$pkgdir/usr/bin/fcitx5-session-start"
	install -Dm644 "$srcdir/fcitx5.desktop" \
		"$pkgdir/etc/phrog/autostart/fcitx5.desktop"
	install -Dm644 "$srcdir/fcitx5.desktop" \
		"$pkgdir/etc/xdg/autostart/fcitx5.desktop"
	install -Dm644 "$srcdir/fcitx5-profile" \
		"$pkgdir/etc/skel/.config/fcitx5/profile"
}

nonfree_firmware() {
	pkgdesc="GPU, venus, modem and sensor firmware"
	depends="
		firmware-xiaomi-lmi
		firmware-qcom-adreno-a650
		linux-firmware-qcom
		linux-firmware-qca
		linux-firmware-ath11k
		tqftpserv
	"
	mkdir "$subpkgdir"

	install -Dm644 "$srcdir"/81-libssc-xiaomi-lmi.rules \
		"$subpkgdir"/etc/udev/rules.d/81-libssc-xiaomi-lmi.rules

	install -Dm644 "$srcdir"/hexagonrpcd.confd \
		"$subpkgdir"/usr/share/hexagonrpcd/hexagonrpcd-sdsp.conf
}

nonfree_firmware_openrc() {
	install_if="$pkgname-nonfree-firmware=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="
		hexagonrpcd-openrc
		tqftpserv-openrc
	"
	mkdir -p "$subpkgdir"
}

